{
  "extends": "@moddable/typings/tsconfig.es2025.json",
  "compilerOptions": {
    "strict": true,
    "incremental": true,
    "outDir": "build",
    "module": "es2022",
    "sourceMap": false,
    "target": "ES2022",
    "types": [
      "./node_modules/@moddable/typings/xs",
      "./node_modules/@moddable/typings/mcpack",
      "./types/lib-dom"
    ],
    "rootDir": "./src",
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    "lib": ["es2022", "esnext.disposable"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/lib/**/*"]
}
